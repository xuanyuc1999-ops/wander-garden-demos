extends "res://tests/playthrough.gd"
func _ready() -> void:
	await wait(.3)
	await key(KEY_ENTER)
	await walk(Vector3(-3,0,4))
	await key(KEY_E)
	await walk(Vector3(-4,0,-3))
	await key(KEY_F)
	await key(KEY_E)
	await key(KEY_F5)
	check(FileAccess.file_exists(game.save_file()),"art_preview_save_written")
	var before=game.save_payload()
	var stored=JSON.parse_string(FileAccess.get_file_as_string(game.save_file()))
	await walk(Vector3(0,0,4))
	game.load_game()
	var after=game.save_payload()
	check(before.seeds==after.seeds and before.plots==after.plots,"art_preview_disk_restore_crops_inventory",{"before_seeds":before.seeds,"after_seeds":after.seeds,"before_plots":before.plots,"after_plots":after.plots})
	check(Vector2(stored.pos[0],stored.pos[1]).distance_to(Vector2(after.pos[0],after.pos[1]))<.01,"art_preview_disk_restore_position",{"saved":stored.pos,"restored":after.pos})
	check(game.save_file()!=game.ART_SAVE,"save_test_isolated_from_player_progress")
	finish()
